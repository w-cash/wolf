# Add this server block to the existing nginx configuration after obtaining a
# certificate for this dedicated hostname. Test with the deployed nginx version.
server {
    listen 443 ssl http2;
    server_name wallet-mainnet.wcashwallet.com;

    ssl_certificate /etc/letsencrypt/live/wallet-mainnet.wcashwallet.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wallet-mainnet.wcashwallet.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log off;
    client_max_body_size 4m;

    location / {
        grpc_pass grpc://127.0.0.1:48234;
        grpc_read_timeout 1h;
        grpc_send_timeout 1h;
    }
}
