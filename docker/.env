# Configuration variables for running Wcash in Docker

# Sets the path to a custom Wcash config file. If not set, Wcash will look for a config at
# ${HOME}/.config/wcash.toml or use the environment variables below.
# WCASH_* environment variables override values from that file.
#
# CONFIG_FILE_PATH="/path/to/your/custom/wcash.toml"

# Selects the built-in local Wcash network.
#
# WCASH_NETWORK__NETWORK=WcashRegtest

# If behind a NAT, firewall, or load balancer, set this to your public IP:port
# so explicitly configured Wcash Regtest peers can connect to yours.
#
# WCASH_NETWORK__EXTERNAL_ADDR=203.0.113.42:28233

# Wcash's RPC server is disabled by default. To enable it, set the listen address.
#
# WCASH_RPC__LISTEN_ADDR=0.0.0.0:28232

# To disable cookie authentication, set the value below to false.
#
# WCASH_RPC__ENABLE_COOKIE_AUTH=false

# Sets a custom directory for the cookie authentication file.
#
# WCASH_RPC__COOKIE_DIR="/home/zebra/.cache/wcash"

# Sets a custom directory for the state and network caches.
#
# WCASH_STATE__CACHE_DIR="/home/zebra/.cache/wcash"
# WCASH_NETWORK__CACHE_DIR="/home/zebra/.cache/wcash"

# Sets custom Cargo features. Available features are listed at
# <https://docs.rs/zebrad/latest/zebrad/index.html#zebra-feature-flags>.
#
# Must be set at build time.
#
# FEATURES=""

# Sets the listen address and port for Prometheus metrics.
#
# WCASH_METRICS__ENDPOINT_ADDR="0.0.0.0:9999"

# Logging to a file is disabled by default. To enable it, uncomment the line
# below and alternatively set your own path.
#
# WCASH_TRACING__LOG_FILE="/home/zebra/.local/state/wcash.log"

# Wcash recognizes whether its logs are being written to a terminal or a file,
# and uses colored logs for terminals and uncolored logs for files. Setting the
# variable below to true will force colored logs even for files and setting it
# to false will disable colors even for terminals.
#
# WCASH_TRACING__USE_COLOR=true

# To disable logging to journald, set the value to false.
#
# WCASH_TRACING__USE_JOURNALD=true

# Sets the listen address and port for the tracing endpoint.
# Only active when the 'filter-reload' feature is enabled.
#
# WCASH_TRACING__ENDPOINT_ADDR="0.0.0.0:3000"

# If you are going to use Wcash as a backend for a mining pool, set your mining
# address. A transparent Wcash address is the normal pool-compatible payout; a
# Wcash Unified Address with an Orchard receiver opts into private Ironwood.
#
# WCASH_MINING__MINER_ADDRESS="your_mining_address"

# Controls the output of `env_logger`:
# https://docs.rs/env_logger/latest/env_logger/
#
# Must be set at build time.
#
# RUST_LOG=info
